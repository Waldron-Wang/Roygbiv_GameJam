  m_Script: {fileID: 11500000, guid: c902ba2dc6ded481ba41a50ce98aa645, type: 3}
  m_Name: Story_Prologue
  m_EditorClassIdentifier: Assembly-CSharp::Roygbiv.DialogueData
  lines:
  - speaker: 
    text: "Once, every color had a place in the heart."
  - speaker: 
    text: "<color=#FFD93B>Warmth</color>. <color=#FF9A2E>Excitement</color>. <color=#FF4A3D>Passion</color>. Even <color=#4CD964>envy</color>, and <color=#3D8BFF>sadness</color>. Each one mattered."
  - speaker: 
    text: "Then the <color=#C266FF>Sovereign</color> decreed: no more feeling. No more pain."
  - speaker: 
    text: "The colors scattered. Each one alone, each one lost."
  - speaker: 
    text: "But a spark of <color=#FFD93B>yellow</color> still remembers."
  - speaker: 
    text: "Go. Bring them home."
